```gitignore
# Compiled executable
/cpack

# Test executables
/test_*

# Compiled object files
*.o
*.obj

# Executables
*.exe
*.out
*.app

# Debug symbols
*.dSYM/

# Build directories
build/
bin/

# IDE files
.vscode/
.vs/
.idea/

# macOS
.DS_Store

# Temporary files
*.tmp
*.log

# Generated CPack archives and restored outputs
*.cpk
*.restored

# CPack benchmark generated files
/benchmark/cpack_benchmark
benchmark/data/

# Temporary test files
sample.txt
